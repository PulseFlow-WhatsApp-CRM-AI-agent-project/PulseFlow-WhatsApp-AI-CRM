# ============================================================================
# PulseFlow CRM — Infrastructure Environment Variables (Render ENV)
# Application & integration settings (Meta App ID, Meta App Secret,
# Embedded Signup Configuration ID, WhatsApp Webhook Verify Token,
# Public App URL, and Gemini / OpenAI API Keys & Models) are managed via the
# Admin Settings UI and stored AES-256-GCM encrypted in MongoDB.
# ============================================================================

PORT=3000
MONGODB_URI=
MONGODB_DB_NAME=pulseflow_crm
JWT_SECRET=
JWT_EXPIRES_IN=7d
SETTINGS_ENCRYPTION_KEY=
